# Database (Supabase Postgres).
# DATABASE_URL is the direct connection used by Prisma and migration tooling.
DATABASE_URL=""
# DIRECT_URL should be Supabase's session-pooler URL for runtime loyalty queries.
DIRECT_URL=""

# Supabase (public values are safe for the browser; never prefix the service key with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Comma-separated Supabase Auth user ids allowed to use the owner dashboard and APIs
ADMIN_USER_IDS=""

# Pinterest board used for homepage style inspiration (server-only values)
PINTEREST_ACCESS_TOKEN=""
PINTEREST_BOARD_ID=""
