// Database-ready schema mirroring src/lib/types.ts. Not used at runtime yet:
// the app currently runs on the in-memory store in src/lib/db.ts.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id           String        @id @default(cuid())
  name         String
  category     String
  description  String        @default("")
  durationMin  Int
  priceCents   Int
  staff        Staff[]
  appointments Appointment[]
  hairstyles   Hairstyle[]
}

model Hairstyle {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  imageUrl    String
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  priceCents  Int
  durationMin Int
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@index([serviceId])
}

model Staff {
  id           String        @id @default(cuid())
  name         String
  role         String
  email        String        @unique
  workingHours Json // 7 entries, Sunday first: { start: "HH:MM", end: "HH:MM" } | null
  services     Service[]
  appointments Appointment[]
}

model Appointment {
  id            String   @id @default(cuid())
  service       Service  @relation(fields: [serviceId], references: [id])
  serviceId     String
  staff         Staff    @relation(fields: [staffId], references: [id])
  staffId       String
  date          String // YYYY-MM-DD
  time          String // HH:MM
  customerName  String
  customerEmail String
  customerPhone String
  status        String   @default("pending") // pending | confirmed | cancelled
  createdAt     DateTime @default(now())

  @@index([staffId, date])
}

model TrendingStyle {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @unique
  imageUrl       String?  @map("image_url")
  thumbnailUrl   String?  @map("thumbnail_url")
  imageCandidates Json    @default("[]") @map("image_candidates")
  imageCandidatesUpdatedAt DateTime? @map("image_candidates_updated_at") @db.Timestamptz(6)
  sourceUrl      String?  @map("source_url")
  googlePosition Int?     @map("google_position")
  trendScore     Int      @default(0) @map("trend_score")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("trending_styles")
  @@index([trendScore(sort: Desc), updatedAt(sort: Desc)])
}

model StyleInquiry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  styleName     String   @map("style_name")
  customerName  String   @map("customer_name")
  customerEmail String   @map("customer_email")
  customerPhone String   @map("customer_phone")
  message       String   @default("")
  sourceUrl     String?  @map("source_url")
  status        String   @default("new")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("style_inquiries")
  @@index([status, createdAt(sort: Desc)])
}
